{{ $name := .File.ContentBaseName }}
{{ $src := "" }}
{{ with .Params.audio }}
  {{ $src = . }}
{{ else }}
  {{ if os.FileExists (printf "static/audio/%s.mp3" $name) }}
    {{ $src = printf "/audio/%s.mp3" $name }}
  {{ end }}
{{ end }}

{{ if $src }}
<div class="voice" dir="rtl">
  <audio preload="metadata" src="{{ $src }}"></audio>
  <button type="button" class="voice-btn" aria-label="ލިޔުން އަޑުއަހައިލުމަށް">
    <svg class="i-play" viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
    <svg class="i-pause" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" style="display:none"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>
  </button>
  <div class="voice-main">
    <div class="voice-label">ލިޔުން އަޑުއަހައިލުމަށް</div>
    <div class="voice-bar" tabindex="0" role="slider" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
      <div class="voice-fill"></div>
    </div>
  </div>
  <div class="voice-time" dir="ltr">0:00 / 0:00</div>
</div>

<style>
  .voice{display:flex;align-items:center;gap:12px;max-width:420px;margin:1rem 0;padding:10px 14px;border:1px solid rgba(128,128,128,.35);border-radius:999px}
  .voice-btn{flex:none;width:38px;height:38px;border-radius:50%;border:0;cursor:pointer;display:flex;align-items:center;justify-content:center;background:currentColor}
  .voice-btn svg{color:#fff;mix-blend-mode:difference}
  .voice-main{flex:1;min-width:0}
  .voice-label{font-size:.9rem;margin-bottom:6px}
  .voice-bar{height:6px;border-radius:3px;background:rgba(128,128,128,.3);cursor:pointer;overflow:hidden}
  .voice-fill{height:100%;width:0;background:currentColor;border-radius:3px}
  .voice-time{flex:none;font-size:.75rem;opacity:.7;font-variant-numeric:tabular-nums}
</style>

<script>
(function(){
  var box=document.currentScript.previousElementSibling.previousElementSibling;
  var a=box.querySelector('audio'),btn=box.querySelector('.voice-btn'),
      play=box.querySelector('.i-play'),pause=box.querySelector('.i-pause'),
      bar=box.querySelector('.voice-bar'),fill=box.querySelector('.voice-fill'),
      time=box.querySelector('.voice-time');
  function f(s){s=Math.floor(s||0);return Math.floor(s/60)+':'+String(s%60).padStart(2,'0');}
  function ui(){
    var p=a.duration?a.currentTime/a.duration*100:0;
    fill.style.width=p+'%';
    bar.setAttribute('aria-valuenow',Math.round(p));
    time.textContent=f(a.currentTime)+' / '+f(a.duration);
  }
  btn.addEventListener('click',function(){a.paused?a.play():a.pause();});
  a.addEventListener('play',function(){play.style.display='none';pause.style.display='';});
  a.addEventListener('pause',function(){play.style.display='';pause.style.display='none';});
  a.addEventListener('timeupdate',ui);
  a.addEventListener('loadedmetadata',ui);
  bar.addEventListener('click',function(e){
    var r=bar.getBoundingClientRect();
    if(a.duration)a.currentTime=(r.right-e.clientX)/r.width*a.duration;
  });
  bar.addEventListener('keydown',function(e){
    if(e.key==='ArrowLeft')a.currentTime+=5;
    if(e.key==='ArrowRight')a.currentTime-=5;
  });
})();
</script>
{{ end }}